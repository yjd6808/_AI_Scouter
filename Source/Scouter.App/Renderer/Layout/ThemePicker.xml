<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="scouter/gui" Name="theme_picker" Title="테마">
	<DataList>
		<Data Key="filter" Type="String" Value=""/>
	</DataList>
	<StackPanel ContentHost="true" Spacing="8" Margin="12">
		<TextBox Name="txt_filter" Placeholder="검색" />
		<ComboBox Name="cmb_scheme" />
		<ListBox Name="lst_themes" MaxHeight="320" />
		<StackPanel Orientation="Horizontal" Spacing="8">
			<Button Name="btn_apply" Content="적용" Variant="Primary" IsDefault="true" />
			<Button Name="btn_cancel" Content="취소" Variant="Ghost" IsCancel="true" />
		</StackPanel>
	</StackPanel>
</Window>
