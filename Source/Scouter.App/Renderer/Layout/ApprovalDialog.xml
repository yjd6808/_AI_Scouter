<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="scouter/gui" Name="approval_dialog" Title="도구 실행 승인">
	<DataList>
		<Data Key="toolName" Type="String" Value=""/>
		<Data Key="clientName" Type="String" Value=""/>
		<Data Key="argsJson" Type="String" Value="{}"/>
		<Data Key="remember" Type="Bool" Value="false"/>
	</DataList>
	<StackPanel ContentHost="true" Spacing="8" Margin="12">
		<TextBlock Text="다음 도구를 실행하려 합니다." />
		<TextBlock Name="txt_tool" Text="{@toolName}" />
		<TextBlock Name="txt_args" Text="{@argsJson}" />
		<CheckBox Name="chk_remember" Content="이 세션에서 같은 도구는 다시 묻지 않기" />
		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
			<Button Name="btn_deny" Content="거부" Variant="Ghost" IsCancel="true" />
			<Button Name="btn_allow" Content="한 번 허용" Variant="Primary" IsDefault="true" />
			<Button Name="btn_always" Content="항상 허용" Variant="Primary" />
		</StackPanel>
	</StackPanel>
</Window>
