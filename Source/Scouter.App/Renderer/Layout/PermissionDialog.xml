<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="scouter/gui" Name="permission_dialog" Title="Plugin 권한">
	<DataList>
		<Data Key="pluginName" Type="String" Value=""/>
		<Data Key="permText" Type="String" Value=""/>
	</DataList>
	<StackPanel ContentHost="true" Spacing="8" Margin="12">
		<TextBlock Name="txt_plugin" Text="{@pluginName}" />
		<TextBlock Name="txt_perms" Text="{@permText}" />
		<StackPanel Orientation="Horizontal" Spacing="8">
			<Button Name="btn_deny" Content="거부" Variant="Ghost" IsCancel="true" />
			<Button Name="btn_allow" Content="허용" Variant="Primary" IsDefault="true" />
		</StackPanel>
	</StackPanel>
</Window>
