		<Item Key="category" Type="String" Value="Ui" />
	</UserControl.Data>
	<Grid ContentHost="true">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
