{
	"name": "scouter",
	"private": true,
	"type": "module",
	"version": "0.4.0",
	"description": "로컬 개발자 유틸리티 허브",
	"author": "Scouter",
	"main": "dist/main/Main.cjs",
	"workspaces": [
		"Source/*",
		"Plugins/*"
	],
	"scripts": {
		"clean": "rimraf Source/*/dist dist",
		"typecheck": "tsc -b Source/Scouter.Gui Source/Scouter.PluginApi Source/Scouter.App Source/Scouter.Harness Plugins/P4Util Plugins/Notes Plugins/ToastLab Plugins/ControlLab",
		"lint": "eslint . --max-warnings 0",
		"lint:layout": "node --import tsx Scripts/LayoutLint.mjs Source/Scouter.App/Renderer/Layout Plugins/P4Util/Layout Plugins/Notes/Layout Plugins/ToastLab/Layout Plugins/ControlLab/Layout",
		"lint:theme": "node --import tsx Scripts/ThemeLint.mjs Source/Scouter.App/Renderer/Theme/Themes",
		"build:main": "webpack -c webpack/main.cjs",
		"build:renderer": "webpack -c webpack/renderer.cjs",
		"build": "npm run build:main && npm run build:renderer",
		"dev": "concurrently -k -n main,renderer,app \"webpack -c webpack/main.cjs --watch\" \"webpack -c webpack/renderer.cjs --watch\" \"wait-on dist/main/Main.cjs dist/renderer/Index.html && electronmon dist/main/Main.cjs -- --no-auth --layout-dir Source/Scouter.App/Renderer/Layout\"",
		"start": "electron dist/main/Main.cjs",
		"test": "npm run test:unit",
		"test:unit": "node Scripts/RunUnit.mjs",
		"test:cov": "cross-env COV=1 node Scripts/RunUnit.mjs",
		"test:rules": "node Scripts/EslintPlugin/tests/plugin.test.mjs",
		"test:e2e": "node Scripts/RunE2e.mjs",
		"pack": "electron-builder --win nsis --x64",
		"harness": "node Source/Scouter.Harness/dist/Cli.js"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^17.6.3",
		"@stylistic/eslint-plugin": "^3.1.0",
		"@types/node": "^22.7.0",
		"c8": "^10.1.0",
		"concurrently": "^9.0.0",
		"copy-webpack-plugin": "^12.0.0",
		"cross-env": "^7.0.0",
		"css-loader": "^7.1.0",
		"electron": "^33.0.0",
		"electron-builder": "^25.0.0",
		"electronmon": "^2.0.0",
		"eslint": "^9.12.0",
		"happy-dom": "^17.0.0",
		"html-webpack-plugin": "^5.6.0",
		"monaco-editor": "^0.56.0",
		"monaco-editor-webpack-plugin": "^7.1.0",
		"playwright": "^1.48.0",
		"rimraf": "^6.0.0",
		"style-loader": "^4.0.0",
		"ts-loader": "^9.5.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.8.0",
		"wait-on": "^8.0.0",
		"webpack": "^5.96.0",
		"webpack-cli": "^6.0.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"chokidar": "^5.0.0",
		"croner": "^10.0.1",
		"dompurify": "^3.4.15",
		"electron-updater": "^6.8.9",
		"esbuild": "^0.28.2",
		"marked": "^15.0.12",
		"zod": "^4.6.2"
	}
}
