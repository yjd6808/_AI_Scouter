{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "P4Util Settings",
	"type": "object",
	"properties":
	{
		"DefaultDepot": { "type": "string", "default": "//depot/project/..." },
		"P4Port": { "type": "string", "default": "" },
