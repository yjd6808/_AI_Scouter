<?xml version="1.0" encoding="UTF-8"?>
<UserControl xmlns="scouter/gui" Name="controllab_main">
	<UserControl.Data>
		<Item Key="eventCount" Type="Int" Value="0" />
		<Item Key="lastEvent" Type="String" Value="대기" />
	</UserControl.Data>
	<DockPanel LastChildFill="true">
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12">
			<TextBlock Text="ControlLab" FontSize="15" />
			<Button Name="btn_clear" Content="기록 지우기" Variant="Ghost" />
			<Button Name="btn_sample" Content="샘플 로그" Variant="Primary" />
		</StackPanel>
		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem>
				<StatusDot Name="dot_state" Status="Idle" />
			</StatusBarItem>
			<StatusBarItem>
				<TextBlock Name="txt_state" Text="{@lastEvent}" />
			</StatusBarItem>
			<StatusBarItem DockPanel.Dock="Right">
				<TextBlock Name="txt_count" Text="{{@eventCount} + ` events`}" />
			</StatusBarItem>
		</StatusBar>
		<TabControl Name="tabs_main">
			<TabItem Header="버튼d">
				<ScrollViewer>
					<StackPanel Spacing="8" Margin="12">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Name="btn_primary" Content="Primary" Variant="Primary" />
							<Button Name="btn_ghost" Content="Ghost" Variant="Ghost" FontSize="18" />
							<Button Name="btn_danger" Content="Danger" Variant="Danger" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Name="btn_icon" Content="검색" Icon="search" />
							<RepeatButton Name="btn_repeat" Content="반복" />
							<ToggleButton Name="tgl_demo" Content="토글" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="8">
							<CheckBox Name="chk_demo" Content="체크박스" IsChecked="true" />
							<RadioButton Name="radio_a" GroupName="demo" Content="라디오 A" />
							<RadioButton Name="radio_b" GroupName="demo" Content="라디오 B" />
						</StackPanel>
						<Separator Name="sep_demo" />
						<TextBlock Name="txt_wrap" Text="긴 텍스트 래핑 확인용 문장입니다. 창을 줄이면 줄바꿈됩니다." TextWrapping="Wrap" FontSize="15" />
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Icon Name="package" Size="16" />
							<Icon Name="search" Size="24" />
							<Image Name="img_demo" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="입력">
				<ScrollViewer>
					<StackPanel Spacing="8" Margin="12">
						<Label Name="lbl_target" Content="이름" Target="#txt_input" />
						<TextBox Name="txt_input" Placeholder="텍스트 입력" />
						<PasswordBox Name="pwd_input" Placeholder="비밀번호" />
						<TextBox Name="txt_multi" AcceptsReturn="true" Placeholder="여러 줄" />
						<NumericUpDown Name="num_demo" Minimum="0" Maximum="100" Value="5" />
						<Slider Name="slider_demo" Minimum="0" Maximum="100" Value="30" />
						<ProgressBar Name="bar_demo" Minimum="0" Maximum="100" Value="30" />
						<ComboBox Name="cmb_demo" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="목록">
				<ScrollViewer>
					<StackPanel Spacing="8" Margin="12">
						<ListBox Name="lst_demo" />
						<ListView Name="lst_view" SelectionMode="Extended" />
						<TreeView Name="tree_demo" />
						<Menu Name="menu_demo">
							<MenuItem Name="menu_file" Header="파일" />
							<MenuItem Name="menu_edit" Header="편집" InputGestureText="Ctrl+E" />
						</Menu>
						<ToolBar Name="bar_tools">
							<Button Name="btn_tool_a" Content="도구 A" Variant="Ghost" />
							<Button Name="btn_tool_b" Content="도구 B" Variant="Ghost" />
						</ToolBar>
						<Expander Name="exp_demo" Header="펼치기">
							<TextBlock Text="숨은 내용" />
						</Expander>
						<GroupBox Name="grp_demo" Header="그룹">
							<CheckBox Name="chk_group" Content="그룹 안 체크" />
						</GroupBox>
						<DataGrid Name="grid_demo" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="Scouter">
				<ScrollViewer>
					<StackPanel Spacing="8" Margin="12">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Badge Name="badge_demo" Text="7" Variant="Success" />
							<Avatar Name="avatar_demo" Text="홍 길동" Size="32" />
							<StatusDot Name="dot_demo" Status="Busy" />
							<Spinner Name="spin_demo" Size="20" />
						</StackPanel>
						<LogView Name="log_demo" />
						<VirtualList Name="virtual_demo" />
						<CodeEditor Name="code_demo" Language="typescript" />
						<DiffView Name="diff_demo" Language="typescript" />
						<MarkdownView Name="md_demo" />
						<PropertyGrid Name="grid_props" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="패널">
				<ScrollViewer>
					<StackPanel Spacing="8" Margin="12">
						<Border Name="border_demo" Padding="8">
							<TextBlock Text="테두리 안" />
						</Border>
						<WrapPanel Name="wrap_demo">
							<Button Name="btn_wrap_a" Content="랩 A" Variant="Ghost" />
							<Button Name="btn_wrap_b" Content="랩 B" Variant="Ghost" />
							<Button Name="btn_wrap_c" Content="랩 C" Variant="Ghost" />
						</WrapPanel>
						<UniformGrid Name="uniform_demo" Columns="2">
							<TextBlock Text="셀 1" />
							<TextBlock Text="셀 2" />
							<TextBlock Text="셀 3" />
							<TextBlock Text="셀 4" />
						</UniformGrid>
						<Canvas Name="canvas_demo" Height="60">
							<TextBlock Name="txt_canvas" Text="절대 배치" Canvas.Left="10" Canvas.Top="10" />
						</Canvas>
						<Viewbox Name="view_demo">
							<TextBlock Text="뷰박스" />
						</Viewbox>
						<Grid Name="grid_split">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="120" MinWidth="60" MaxWidth="240" />
								<ColumnDefinition Width="8" MinWidth="8" MaxWidth="8" />
								<ColumnDefinition Width="*" MinWidth="80" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="왼쪽" />
							<GridSplitter Grid.Column="1" />
							<TextBlock Grid.Column="2" Text="오른쪽" />
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
